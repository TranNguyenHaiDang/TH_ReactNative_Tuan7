{
  "name": "bookstore-api",
  "version": "1.0.0",
  "description": "json-server + json-server-auth cho bài thực hành BookStore",
  "scripts": {
    "start": "json-server-auth db.json -r routes.json --port 3000 --host 0.0.0.0",
    "reset": "node -e \"require('fs').copyFileSync('db.seed.json','db.json'); console.log('Đã khôi phục db.json')\""
  },
  "dependencies": {
    "json-server": "0.17.4",
    "json-server-auth": "2.1.0"
  },
  "private": true
}